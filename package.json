{
  "name": "captainhook",
  "version": "0.2.1",
  "description": "Git hooks made easy, even for a codfish.",
  "author": "Dan Imhoff <dwieeb@gmail.com>",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "captainhook": "bin/captainhook"
  },
  "scripts": {
    "lint": "npm run eslint && npm run prettier -- --check",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier 'src/**/*.ts'",
    "tsc": "tsc",
    "ncc": "ncc build build/index.js -o dist",
    "tsc:watch": "npm run tsc -- -w",
    "ncc:watch": "npm run ncc -- --watch",
    "build": "npm run clean && npm run tsc && npm run ncc",
    "clean": "rimraf build dist",
    "postinstall": "bin/captainhook install",
    "uninstall": "bin/captainhook uninstall",
    "prepublishOnly": "npm run build"
  },
  "hooks": {
    "pre-commit": "npm run lint"
  },
  "keywords": [
    "git",
    "hook",
    "hooks",
    "test",
    "lint",
    "applypatch-msg",
    "pre-applypatch",
    "post-applypatch",
    "pre-commit",
    "prepare-commit-msg",
    "commit-msg",
    "post-commit",
    "pre-rebase",
    "post-checkout",
    "post-merge",
    "post-update",
    "pre-auto-gc",
    "post-rewrite",
    "pre-push"
  ],
  "devDependencies": {
    "@imhoff/eslint-config": "^3.0.0",
    "@imhoff/prettier-config": "^2.2.0",
    "@types/node": "^25.0.3",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^8.57.1",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "prettier": "@imhoff/prettier-config",
  "eslintConfig": {
    "extends": "@imhoff/eslint-config/recommended",
    "parserOptions": {
      "project": "./tsconfig.json"
    },
    "rules": {
      "import/prefer-default-export": "off"
    }
  }
}
